{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    // Without this, Cloudflare tries to match these paths against static
    // files first. Since there's no static file for a TanStack Start
    // server-function URL, it was falling back to serving index.html with a
    // 200 status — an HTML page instead of the server function's JSON
    // response, which is exactly the "Unexpected token '<'" error.
    "run_worker_first": ["/_serverFn/*", "/api/*"]
  }
}